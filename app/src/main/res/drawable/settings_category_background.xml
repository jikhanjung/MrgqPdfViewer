<?xml version="1.0" encoding="utf-8"?>
<!-- TV 설정 두 칸의 왼쪽 카테고리 줄 — elegant_file_item_background 에 "오른쪽에 보이는 카테고리"(selected)를 더함 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#30FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#60FFFFFF" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#25FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/tv_primary" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#15FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</selector>
