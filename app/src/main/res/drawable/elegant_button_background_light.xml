<?xml version="1.0" encoding="utf-8"?>
<!-- 검은 그림 이모지 단추(첫 화면 합주 🎼)용 밝은 바탕 — 설정 카테고리의 밝은 동그라미(#D6E2F0)와 같은 색.
     포커스는 흰 바탕 + 파란 테두리로 기본과 구분 (TV 리모컨) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#8AB4F8" />
        </shape>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#B8C8DC" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D6E2F0" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</selector>
