<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pdf_background"
    android:theme="@style/Theme.MrgqPdfViewer.PdfViewer"
    tools:context=".PdfViewerActivity">

    <ImageView
        android:id="@+id/pdfView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:background="@color/white"
        android:contentDescription="@string/app_name"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Second ImageView for page transition animations -->
    <ImageView
        android:id="@+id/pdfViewNext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:background="@color/white"
        android:contentDescription="@string/app_name"
        android:visibility="gone" />

    <!-- 악보 메모 (P11) — 쪽 pt 에 붙은 펜 획. pdfView 와 같은 위치·크기여야 한다 -->
    <com.mrgq.pdfviewer.notes.ScoreNotesView
        android:id="@+id/noteLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 악보 분석 확인용 마디 박스 (PDF 표시 옵션에서 켬). pdfView 와 같은 위치·크기여야 한다 -->
    <com.mrgq.pdfviewer.score.ScoreOverlayView
        android:id="@+id/scoreOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 메트로놈 박 표시 (실행 중에만) -->
    <com.mrgq.pdfviewer.metronome.MetronomeBeatView
        android:id="@+id/metronomeBeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 마이크 추적 상태 · 지금 마디 (P10, 태블릿 지휘자) — 오른쪽 위 합주 표시 바로 아래 (합주가 아니면 그 자리) -->
    <TextView
        android:id="@+id/micStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        app:layout_goneMarginTop="16dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:background="#99000000"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/collaborationStatus"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 악보 연동 예비박: 남은 마디 수를 화면 가운데에 크게 (노래방처럼 2 → 1, #060). 예비박 동안에만 -->
    <TextView
        android:id="@+id/countInNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="240sp"
        android:textStyle="bold"
        android:textColor="#D9FF9800"
        android:shadowColor="#99000000"
        android:shadowRadius="24"
        android:includeFontPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/pageInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/pdf_page_info_bg"
        android:padding="@dimen/page_info_padding"
        android:text="@string/page_info"
        android:textColor="@color/white"
        android:textSize="@dimen/page_info_text_size"
        android:layout_margin="@dimen/page_info_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Collaboration Status -->
    <TextView
        android:id="@+id/collaborationStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/pdf_page_info_bg"
        android:padding="8dp"
        android:text="지휘자: 3명 연결"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Navigation Guide - Split Left/Right Design -->
    <LinearLayout
        android:id="@+id/navigationGuide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="32dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left Navigation -->
        <LinearLayout
            android:id="@+id/leftNavigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@color/pdf_page_info_bg"
            android:padding="24dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_left_large"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/leftNavText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이전 파일"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/leftNavSubText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="파일명.pdf"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Right Navigation -->
        <LinearLayout
            android:id="@+id/rightNavigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@color/pdf_page_info_bg"
            android:padding="24dp"
            android:layout_marginStart="16dp"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_right_large"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/rightNavText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다음 파일"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/rightNavSubText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="파일명.pdf"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 메모 모드 도구 줄 (P11) — 단추는 코드에서 채운다 -->
    <!-- 🎙 음성 명령 (P12, 태블릿 · 휴대폰) — 누르는 동안 듣는다. 설정 → 앱 정보에서 켤 때만 보인다 -->
    <TextView
        android:id="@+id/voiceButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_margin="16dp"
        android:background="@drawable/voice_button_background"
        android:contentDescription="음성 명령 — 누른 채로 말하기"
        android:elevation="6dp"
        android:gravity="center"
        android:text="🎙"
        android:textSize="28sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🎙 듣는 중 · 알아들은 말 · 결과 -->
    <TextView
        android:id="@+id/voiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:background="#CC000000"
        android:elevation="6dp"
        android:maxLines="3"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintBottom_toTopOf="@+id/voiceButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/noteToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:background="#E6263238"
        android:elevation="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>