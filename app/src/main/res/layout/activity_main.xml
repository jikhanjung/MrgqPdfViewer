<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_gradient_background"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher_round"
            android:layout_marginEnd="16dp" />

        <!-- 제목 칸: 가로면 [앱 이름 · 버전 · × ScoreMate] 한 줄, 세로(태블릿)면 그 아래 줄에 × ScoreMate -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.1.8"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />

            <!-- ScoreMate 에 연결된 TV: 앱 이름 옆에 "× ScoreMate ☁️" (사용자 요청 2026-09-28) — 서재가 ScoreMate 라는 표시.
                 색은 휴대폰 제목과 같은 연한 파랑 (사용자 요청 2026-10-09) -->
            <TextView
                android:id="@+id/scoreMateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="×  ScoreMate ☁️"
                android:textColor="#FF90CAF9"
                android:textSize="20sp"
                android:layout_marginStart="14dp"
                android:visibility="gone" />
        </LinearLayout>

            <!-- 세로 화면(태블릿): 제목 바로 아래 줄 (사용자 요청 2026-09-28), 연한 파랑 (2026-10-09) -->
            <TextView
                android:id="@+id/scoreMateBadgeBelow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="× ScoreMate ☁️"
                android:textColor="#FF90CAF9"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/collaborationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="합주 모드: 비활성"
                android:textColor="#B0FFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="12dp"
                android:visibility="visible" />

            <Button
                android:id="@+id/collaborationButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="합주"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:background="@drawable/elegant_button_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="8dp"
                android:focusable="true"
                android:minHeight="0dp" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="설정"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:background="@drawable/elegant_button_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:focusable="true"
                android:minHeight="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 지금 서재 (#063) + 세트리스트 줄 (#064): 연결된 TV 에서 받은 세트리스트가 있으면 [곡목 A] [곡목 B] … [🔄 동기화]
         포커스만 옮겨도 바뀐다. 세트리스트를 고르면 곡 순서대로 (이전/다음 파일도) -->
    <LinearLayout
        android:id="@+id/libraryRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/librarySource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:textSize="18sp"
            android:textColor="@android:color/white" />

        <HorizontalScrollView
            android:id="@+id/setlistScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/setlistTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ScoreMate 동기화 (#062) — 연결된 TV 에서만. 주기적 동기화 대신 필요할 때 누른다 (사용자 결정).
             연결된 TV 는 아래 정렬 · 파일관리 줄을 통째로 숨기므로 이 줄 오른쪽 끝에 둔다 -->
        <Button
            android:id="@+id/scoreMateSyncBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 동기화"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:background="@drawable/elegant_button_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:layout_marginStart="12dp"
            android:visibility="gone"
            android:focusable="true"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Control Strip — 정렬 · 파일관리. ScoreMate 에 연결된 TV 에서는 숨긴다(곡 순서 · 서버가 관리) -->
    <LinearLayout
        android:id="@+id/controlStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/libraryRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/sortLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="정렬"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/sortByNameBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이름순"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:background="@drawable/elegant_button_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp"
            android:focusable="true"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/sortByTimeBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="시간순"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:background="@drawable/elegant_button_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp"
            android:focusable="true"
            android:minHeight="0dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/fileManageBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="파일관리"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:background="@drawable/elegant_button_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:focusable="true"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- File List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:padding="8dp"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        app:layout_constraintTop_toBottomOf="@id/controlStrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/controlStrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/emptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PDF 파일이 없습니다"
            android:textColor="#80FFFFFF"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정에서 웹서버를 통해 파일을 업로드하세요"
            android:textColor="#60FFFFFF"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>