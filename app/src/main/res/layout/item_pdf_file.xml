<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/elegant_file_item_background"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp"
    android:layout_marginVertical="4dp"
    android:layout_marginHorizontal="16dp"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <!-- File Name -->
        <TextView
            android:id="@+id/fileNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- PDF 문서 정보 (제목 · 작성자). 없으면 숨김 -->
        <TextView
            android:id="@+id/docInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#B0FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>

    <!-- File Info -->
    <TextView
        android:id="@+id/fileInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B0FFFFFF"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginEnd="12dp" />

    <!-- Delete Button -->
    <Button
        android:id="@+id/deleteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="삭제"
        android:textSize="11sp"
        android:textColor="@color/delete_button_text_color"
        android:background="@drawable/elegant_delete_button_background"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:layout_marginStart="6dp"
        android:focusable="true"
        android:visibility="gone"
        android:minWidth="0dp"
        android:minHeight="0dp" />

</LinearLayout>
