<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for TV.
         Material 다리 테마(P17 0단계): AppCompat 위젯 · 대화상자 모습은 그대로(위젯을 Material 로 바꾸는 inflater 를 넣지 않는다),
         Material 속성만 더해 하단 시트 · 스위치 · 칩을 쓸 수 있게 -->
    <style name="Theme.MrgqPdfViewer" parent="Theme.MaterialComponents.NoActionBar.Bridge">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/tv_primary</item>
        <item name="colorPrimaryVariant">@color/tv_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/tv_secondary</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Background colors -->
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorBackground">@color/tv_background</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/tv_surface</item>
        <item name="colorOnSurface">@color/tv_text_primary</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/tv_error</item>
        <item name="colorOnError">@color/white</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/tv_text_primary</item>
        <item name="android:textColorSecondary">@color/tv_text_secondary</item>
        
        <!-- Window settings -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        
        <!-- Focus highlight -->
        <item name="android:colorControlHighlight">@color/tv_primary</item>
        <item name="android:colorControlActivated">@color/tv_primary</item>
    </style>
    
    <!-- PDF Viewer Theme -->
    <style name="Theme.MrgqPdfViewer.PdfViewer" parent="Theme.MrgqPdfViewer">
        <item name="android:windowBackground">@color/pdf_background</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
    </style>
    
    
    <!-- Splash Activity Theme -->
    <style name="Theme.MrgqPdfViewer.SplashActivity" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_gradient_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- 악보 화면 메뉴 하단 시트 (P17 1단계, 태블릿 · 휴대폰): 어두운 면 · 위 모서리만 둥글게, 스위치는 앱 파랑 -->
    <style name="ThemeOverlay.MrgqPdfViewer.BottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="colorSurface">@color/tv_surface</item>
        <item name="colorOnSurface">@color/tv_text_primary</item>
        <item name="colorPrimary">@color/tv_primary</item>
        <item name="colorSecondary">@color/tv_primary</item>
        <item name="android:textColorPrimary">@color/tv_text_primary</item>
        <item name="android:textColorSecondary">@color/tv_text_secondary</item>
        <item name="bottomSheetStyle">@style/Widget.MrgqPdfViewer.BottomSheet</item>
    </style>

    <style name="Widget.MrgqPdfViewer.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MrgqPdfViewer.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.MrgqPdfViewer.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
