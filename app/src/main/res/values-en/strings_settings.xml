    <!-- Voice commands -->
    <string name="settings_voice_press_header">Push to talk</string>
    <string name="settings_voice_unavailable">This device has no speech recognition service — tap for install help (Google \"Speech Recognition &amp; Synthesis\")</string>
    <string name="settings_voice_on">On — on the score screen, hold 🎙 at the bottom right and speak: \"start from measure 57\" · \"next page\" · \"cello part\" (see Voice command language below). Uses the device\'s speech recognition (usually online)</string>
    <string name="settings_voice_off">Off — turn on to get a 🎙 button on the score screen</string>
    <string name="settings_voice_always">Always listening (experimental)</string>
    <string name="settings_voice_always_unavailable">Not available right now — being refined</string>
    <string name="settings_voice_always_needs_voice">Turn on 🎙 voice commands above first</string>
    <string name="settings_voice_always_on">On — listens all the time on the score screen and runs only what follows the wake word \"%1$s\" (\"%1$s, 57마디부터\" · \"%1$s, 멈춰\"). Also listens while you play. Notification sounds are muted while listening (calls may come as vibration on phones). What it hears keeps going to the device\'s speech recognition (usually Google, online)</string>
    <string name="settings_voice_always_off">Off — turn on to give commands with \"%1$s, …\" without pressing 🎙</string>
    <string name="settings_wake_words">Wake word (always listening)</string>
    <string name="settings_wake_words_desc">%1$s — tap to change</string>
    <string name="settings_wake_words_desc_default">%1$s (default) — tap to change</string>
    <string name="settings_wake_title">🗣 Wake word</string>
    <string name="settings_wake_help">👂 Always listening runs only what you say after this word. Separate several with commas — also add the spellings speech recognition may use (e.g. 마에스트로, maestro). Leave empty for the default (메이트)</string>
    <string name="settings_wake_not_saved">Not saved — %1$s</string>
    <string name="settings_recognizer_missing_title">No speech recognition service</string>
    <string name="settings_recognizer_missing_message">🎙 Voice commands use the device\'s speech recognition.\n\n1. Install Google \"Speech Recognition &amp; Synthesis\"\n2. In device Settings → Apps → Speech Recognition &amp; Synthesis → Permissions, allow the microphone\n3. Come back here and turn on 🎙 voice commands\n\nTablets with a Chinese ROM that only have the Google app have its recognition service turned off, so it must be installed separately.</string>
    <string name="settings_recognizer_open_store">Open in store</string>
    <string name="settings_recognizer_no_store">Can\'t open the store or a browser — find and install %1$s</string>

